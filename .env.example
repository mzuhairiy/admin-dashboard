# Host development only. Compose uses postgres:5432 inside its network.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/admin_dashboard?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Public browser origin for Auth.js. If APP_PORT changes, update this URL too.
AUTH_URL="http://localhost:3000"
APP_PORT=3000

NEXT_PUBLIC_APP_URL="http://localhost:3000"
